# 로컬 환경 변수 예시. 복사해서 .env.local 을 만들고 값을 채운다 (.env.local 은 커밋하지 않는다)
#   cp .env.example .env.local
# 값은 Supabase 대시보드 > Project Settings > API Keys / Data API, Connect > Session pooler 에서 복사한다.
# 비워 두면 앱은 인메모리 저장소로 동작한다 (README "Supabase 연결")

# 공개해도 되는 값 (RLS 로 공개 작업 읽기만 허용)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 서버 전용. RLS 를 우회한다. NEXT_PUBLIC_ 을 붙이지 않는다
SUPABASE_SECRET_KEY=

# 마이그레이션 적용용 (Session pooler 주소, IPv4). 앱 런타임에서는 쓰지 않는다
SUPABASE_DB_URL=

# memory 로 두면 위 값이 있어도 인메모리 저장소를 쓴다 (e2e 가 클라우드 DB 를 건드리지 않게)
DATA_STORE=
