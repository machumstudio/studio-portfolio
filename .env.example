# 로컬 환경 변수 예시. 복사해서 .env.local 을 만들고 값을 채운다 (.env.local 은 커밋하지 않는다)
#   cp .env.example .env.local
# 값은 Supabase 대시보드 > Project Settings > API Keys / Data API, Connect > Session pooler 에서 복사한다.
# 비워 두면 앱은 인메모리 저장소로 동작한다 (README "Supabase 연결")

# 사이트 주소 (canonical, hreflang, sitemap, 공유 카드의 절대 주소). 끝의 / 없이. 예: https://machum.example
# 비우면 Vercel 운영 도메인 → 미리보기 주소 → http://localhost:3000 순서로 정한다 (src/lib/seo/site.ts)
# 검색 색인은 Vercel 운영 배포(VERCEL_ENV=production)만 허용한다. 그 밖은 모든 응답이 noindex (docs/adr/0018)
NEXT_PUBLIC_SITE_URL=

# 공개해도 되는 값 (RLS 로 공개 작업 읽기만 허용). 관리자 로그인(Supabase Auth)도 이 두 값으로 한다
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 서버 전용. RLS 를 우회한다. NEXT_PUBLIC_ 을 붙이지 않는다
SUPABASE_SECRET_KEY=

# 마이그레이션 적용용 (Session pooler 주소, IPv4). 앱 런타임에서는 쓰지 않는다
SUPABASE_DB_URL=

# memory 로 두면 위 값이 있어도 인메모리 저장소를 쓴다 (e2e 가 클라우드 DB 를 건드리지 않게).
# 관리자 로그인도 테스트 계정(src/infrastructure/admin-auth/memory-accounts.ts)으로 바뀐다. 배포에는 넣지 않는다
DATA_STORE=

# 새 문의 알림 메일 (Resend). 키와 받는 주소가 둘 다 있으면 메일을 보내고, 비우면 서버 로그에만 남긴다
# DATA_STORE=memory 면 값이 있어도 보내지 않는다. 키는 Resend 대시보드 > API Keys 에서 Sending access 로 만든다
RESEND_API_KEY=
# 받는 주소. 도메인을 붙이기 전에는 Resend 계정 주인 주소로만 보낼 수 있다
INQUIRY_NOTIFY_EMAIL=
# 보내는 주소. 비우면 Machum Studio <onboarding@resend.dev> (Resend 에 인증한 도메인이 생기면 바꾼다)
INQUIRY_FROM_EMAIL=
